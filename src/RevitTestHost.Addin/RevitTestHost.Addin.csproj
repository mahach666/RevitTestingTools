<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/RevitVersion.props" />

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <RootNamespace>RevitTestHost.Addin</RootNamespace>
    <AssemblyName>RevitTestHost.Addin</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3Point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" />
    <PackageReference Include="Nice3Point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitTestHost.Sdk\RevitTestHost.Sdk.csproj" />
    <ProjectReference Include="..\RevitTestHost.Core\RevitTestHost.Core.csproj" />
  </ItemGroup>

  <!-- Revit сканирует .addin только в корне Addins\{version}\ — манифест кладём туда,
       DLL живут в подпапке TestHost\ (путь в манифесте: TestHost\RevitTestHost.Addin.dll). -->
  <Target Name="CopyAddinToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <RevitAddinFolder>$(RevitAddinsRoot)TestHost\</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" Condition="!Exists('$(RevitAddinFolder)')" />
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll" />
      <DeployFiles Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <DeployFiles Include="$(TargetDir)RevitTestHost.Sdk.dll" />
      <DeployFiles Include="$(TargetDir)RevitTestHost.Core.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\RevitTestHost.addin" DestinationFolder="$(RevitAddinsRoot)" SkipUnchangedFiles="true" />
    <Delete Files="$(RevitAddinFolder)RevitTestHost.addin" Condition="Exists('$(RevitAddinFolder)RevitTestHost.addin')" />
    <Message Text="Deployed RevitTestHost to $(RevitAddinFolder) (manifest in $(RevitAddinsRoot))" Importance="high" />
  </Target>

</Project>
